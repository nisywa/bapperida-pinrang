# Copy the exact hostname and project reference from Supabase > Connect.
# Percent-encode special characters in the database password.
# Runtime: Supavisor transaction pooler (Prisma 6).
DATABASE_URL="postgresql://postgres.PROJECT_REF:ENCODED_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&pool_timeout=20&sslmode=require"
# Prisma CLI/imports: Supavisor session pooler, compatible with IPv4.
DIRECT_URL="postgresql://postgres.PROJECT_REF:ENCODED_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require"
AUTH_SECRET="REPLACE_WITH_A_STRONG_RANDOM_SECRET"
